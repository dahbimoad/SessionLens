<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>SessionLens</AssemblyName>
    <RootNamespace>SessionLens</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>Assets\sessionlens.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>1.0.0</Version>
    <Product>SessionLens</Product>
    <Description>Records a browsing session in Chrome into one zip: actions, DOM, screenshots, network, console.</Description>
    <!-- Properties > Details on SessionLens.exe. The installer repeats both
         (installer\SessionLens.iss). -->
    <Company>iSoutien</Company>
    <Authors>Moad Dahbi</Authors>
    <Copyright>Copyright (c) 2026 Moad Dahbi</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\sessionlens.ico" />
    <EmbeddedResource Include="Assets\recorder.js" LogicalName="SessionLens.recorder.js" />
    <EmbeddedResource Include="Assets\recording-guide.md" LogicalName="SessionLens.recording-guide.md" />
  </ItemGroup>

</Project>
