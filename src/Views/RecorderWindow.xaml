<Window x:Class="SessionLens.Views.RecorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SessionLens"
        Width="400" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/sessionlens.ico"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">

    <!-- The margin leaves room for the drop shadow inside the transparent window. -->
    <Border Margin="18" CornerRadius="16" Background="{StaticResource Paper}"
            BorderBrush="{StaticResource Border}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="5" Direction="270" Opacity="0.18" Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <!-- Custom header: drag to move, SVG buttons, no native title bar. -->
            <Grid Background="Transparent" Margin="18,12,10,0" MouseLeftButtonDown="OnHeaderMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Same mark as Assets/sessionlens.svg, drawn as vectors so it stays sharp at any DPI. -->
                <Viewbox Width="22" Height="22" VerticalAlignment="Center">
                    <Canvas Width="256" Height="256">
                        <Rectangle Canvas.Left="8" Canvas.Top="8" Width="240" Height="240" RadiusX="56" RadiusY="56" Fill="{StaticResource Ink}" />
                        <Line X1="160" Y1="160" X2="204" Y2="204" Stroke="{StaticResource Paper}" StrokeThickness="30"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Ellipse Canvas.Left="34" Canvas.Top="34" Width="152" Height="152" Stroke="{StaticResource Paper}" StrokeThickness="20" />
                        <Ellipse Canvas.Left="78" Canvas.Top="78" Width="64" Height="64" Fill="{StaticResource Accent}" />
                    </Canvas>
                </Viewbox>
                <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                           Text="SessionLens" FontFamily="{StaticResource DisplayFont}"
                           FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />

                <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="OnMinimize"
                        ToolTip="Minimize" AutomationProperties.Name="Minimize">
                    <Viewbox Width="16" Height="16">
                        <Canvas Width="24" Height="24">
                            <Path Style="{StaticResource LineIcon}" Data="M5 12h14" />
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource IconButton}" Click="OnCloseClick"
                        ToolTip="Close" AutomationProperties.Name="Close">
                    <Viewbox Width="16" Height="16">
                        <Canvas Width="24" Height="24">
                            <Path Style="{StaticResource LineIcon}" Data="M18 6 6 18 M6 6l12 12" />
                        </Canvas>
                    </Viewbox>
                </Button>
            </Grid>

            <StackPanel Margin="22,14,22,22">
                <Border x:Name="StatusChip" HorizontalAlignment="Left" CornerRadius="999" Padding="10,3"
                        Background="{StaticResource Well}">
                    <TextBlock x:Name="StatusText" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource InkSoft}" Text="READY" />
                </Border>

                <TextBlock x:Name="IntroText" Style="{StaticResource HelpText}" Margin="0,12,0,0"
                           Text="Press Record. Chrome opens: use your site normally. Press Stop, or just close Chrome, and one zip lands in your Downloads folder." />

                <Grid x:Name="StartUrlPanel" Margin="0,14,0,0">
                    <TextBox x:Name="StartUrlBox" Style="{StaticResource FieldBox}"
                             TextChanged="OnStartUrlChanged"
                             AutomationProperties.Name="Start page" />
                    <TextBlock x:Name="StartUrlPlaceholder" Margin="12,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" FontSize="13" Foreground="{StaticResource InkSoft}"
                               Text="Start page (optional), e.g. my-site.com" />
                </Grid>

                <UniformGrid x:Name="StatsPanel" Columns="4" Margin="-3,14,-3,0" Visibility="Collapsed">
                    <Border Style="{StaticResource StatTile}">
                        <StackPanel>
                            <TextBlock x:Name="ElapsedText" Style="{StaticResource StatValue}" Text="00:00" />
                            <TextBlock Style="{StaticResource StatLabel}" Text="Time" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}">
                        <StackPanel>
                            <TextBlock x:Name="StepsText" Style="{StaticResource StatValue}" Text="0" />
                            <TextBlock Style="{StaticResource StatLabel}" Text="Steps" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}">
                        <StackPanel>
                            <TextBlock x:Name="RequestsText" Style="{StaticResource StatValue}" Text="0" />
                            <TextBlock Style="{StaticResource StatLabel}" Text="Requests" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}">
                        <StackPanel>
                            <TextBlock x:Name="ConsoleText" Style="{StaticResource StatValue}" Text="0" />
                            <TextBlock Style="{StaticResource StatLabel}" Text="Console" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Button x:Name="ToggleButton" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0"
                        Click="OnToggle" IsDefault="True">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="RecordIcon" Width="12" Height="12" Fill="White" VerticalAlignment="Center" />
                        <Rectangle x:Name="StopIcon" Width="12" Height="12" RadiusX="2" RadiusY="2" Fill="White"
                                   VerticalAlignment="Center" Visibility="Collapsed" />
                        <TextBlock x:Name="ToggleText" Margin="10,0,0,0" VerticalAlignment="Center" Text="Record" />
                    </StackPanel>
                </Button>

                <Border x:Name="ResultPanel" Margin="0,14,0,0" Padding="12,10" CornerRadius="10"
                        Background="{StaticResource PositiveSoft}" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Positive}" Text="Recording saved" />
                            <TextBlock x:Name="ResultText" FontSize="11" Foreground="{StaticResource InkSoft}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource QuietButton}" Margin="10,0,0,0"
                                Click="OnShowInFolder" AutomationProperties.Name="Show in folder">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="14" Height="14">
                                    <Canvas Width="24" Height="24">
                                        <Path Style="{StaticResource LineIcon}"
                                              Data="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Margin="6,0,0,0" Text="Show" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <TextBlock x:Name="MessageText" Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource Danger}" Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
