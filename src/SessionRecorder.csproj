<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>SessionRecorder</AssemblyName>
    <RootNamespace>SessionRecorder</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>Assets\session-recorder.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>1.1.0</Version>
    <Product>Session Recorder</Product>
    <Description>Records a browsing session in Chrome into one zip: actions, DOM, screenshots, network, console.</Description>
    <!-- Properties > Details on SessionRecorder.exe. The installer repeats both
         (installer\SessionRecorder.iss). -->
    <Company>iSoutien</Company>
    <Authors>Moad Dahbi</Authors>
    <Copyright>Copyright (c) 2026 Moad Dahbi</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\session-recorder.ico" />
    <EmbeddedResource Include="Assets\recorder.js" LogicalName="SessionRecorder.recorder.js" />
    <EmbeddedResource Include="Assets\recording-guide.md" LogicalName="SessionRecorder.recording-guide.md" />
  </ItemGroup>

</Project>
